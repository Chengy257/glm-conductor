{
  "description": "GLM Conductor v2 enforcement hooks (ZCode plugin layout under hooks/hooks.json).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: building resume context…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop_gate.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: checking completion gate…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/pre_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: checking dispatch permit…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/pre_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: evaluating bash policy…"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/pre_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: checking nested cron create…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/post_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: recording agent run…"
          }
        ]
      },
      {
        "matcher": "CronCreate|CronUpdate|CronDelete",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/post_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: recording scheduler capability…"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/post_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: recording agent failure…"
          }
        ]
      },
      {
        "matcher": "CronCreate|CronUpdate|CronDelete",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/post_tool_use.py"
            ],
            "timeoutMs": 3000,
            "statusMessage": "glm-conductor: recording scheduler rejection…"
          }
        ]
      }
    ]
  }
}
