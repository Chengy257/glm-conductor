{
  "description": "GLM Conductor v2.4 hooks (ZCode plugin layout under hooks/hooks.json). SessionStart resume context + Stop completion guard only — v2.3 enforcement hooks (PreToolUse / PostToolUse / PostToolUseFailure) retired in Phase 2 W6.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: building resume context…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop_gate.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: checking completion gate…"
          }
        ]
      }
    ]
  }
}
