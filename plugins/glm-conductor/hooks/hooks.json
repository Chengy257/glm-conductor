{
  "description": "GLM Conductor hooks: SessionStart resume-context injection and Stop completion guard.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: building resume context…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop_gate.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: checking completion gate…"
          }
        ]
      }
    ]
  }
}
