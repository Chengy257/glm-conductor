{
  "description": "GLM Conductor hooks: SessionStart resume-context injection, Stop completion guard, and PermissionRequest CreateWorkflow task-level auto-approve.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: building resume context…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop_gate.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: checking completion gate…"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "CreateWorkflow",
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/permission_request_workflow.py"
            ],
            "timeoutMs": 5000,
            "statusMessage": "glm-conductor: checking workflow auto-approve…"
          }
        ]
      }
    ]
  }
}
